DATABASE_URL="postgresql://footage_user:footage_pass@localhost:5433/footage_downloader"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="ganti-dengan-secret-acak"
ENCRYPTION_KEY="ganti-dengan-32-byte-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:4000/drive-accounts/connect/callback"
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# TikTok cookies (opsional) — diperlukan agar video sensitif/age-gated bisa diunduh.
# Prioritas: TIKTOK_COOKIES_FILE > TIKTOK_COOKIES_BROWSER.
# TIKTOK_COOKIES_FILE: path ke Netscape cookies.txt (ekspor via "Get cookies.txt LOCALLY").
#   Pilihan utama — deterministik, tidak butuh browser tertutup / keyring.
#   Cookie login (sessionid/sid_guard) valid berminggu-minggu; msToken lebih cepat kedaluwarsa — export ulang jika gagal.
TIKTOK_COOKIES_FILE=""
# TIKTOK_COOKIES_BROWSER: nama browser yang sudah login TikTok (chromium/firefox/edge).
#   Fallback. Butuh browser tertutup + akses keyring — sering gagal di sisi server.
TIKTOK_COOKIES_BROWSER=""
